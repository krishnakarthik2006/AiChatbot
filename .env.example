# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Flask Configuration
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# JWT
JWT_ACCESS_TOKEN_MINUTES=1440

# Chatbot Configuration
CONFIDENCE_THRESHOLD=0.75
MAX_STORED_MESSAGES=28

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# ChromaDB configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION=ai_chatbot_knowledge_base

# RAG configuration (rag_api.py)
GROQ_API_KEY=your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=500
RAG_TOP_K=4
RAG_ADMIN_EMAILS=
RAG_MAX_UPLOAD_BYTES=15728640