# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Flask Configuration
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# JWT
JWT_ACCESS_TOKEN_MINUTES=1440

# Chatbot Configuration
CONFIDENCE_THRESHOLD=0.75
MAX_STORED_MESSAGES=28

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# ChromaDB configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION=ai_chatbot_knowledge_base

# RAG configuration (rag_api.py)
GROQ_API_KEY=your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=500
RAG_TOP_K=4
RAG_ADMIN_EMAILS=
RAG_MAX_UPLOAD_BYTES=15728640

# RAG toggles and tuning
RAG_QUERY_REWRITE=true                     # rewrite multi-turn questions (Groq or local Ollama)
RAG_HYBRID_LEXICAL_WEIGHT=0.35             # BM25 weight for hybrid retrieval (0 = vector only)
RAG_RERANK_ENABLED=false                   # optional cross-encoder re-ranker
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RATE_LIMIT_PER_MINUTE=30               # per-account request quota for the RAG API
OLLAMA_VISION_MODEL=llava                  # vision model used for pasted image descriptions
RAG_STORAGE_GROWTH_ALERT_MB=200            # report storage growth beyond this much between admin checks
RAG_ADMIN_DATA_DIR=./admin_data            # runtime admin telemetry (storage history)